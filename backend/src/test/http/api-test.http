DELETE {{baseUrl}}/products/16
Authorization: Bearer {{adminToken}}


### ==============================================================================
### 05. VOUCHERS & PROMOTIONS (/v1/vouchers)
### ==============================================================================

### 5.1 Lấy danh sách tất cả voucher đang hoạt động
GET {{baseUrl}}/vouchers
Accept: {{contentType}}

### 5.2 Kiểm tra & áp dụng mã voucher GIAM50K (Khớp giỏ hàng)
GET {{baseUrl}}/vouchers/GIAM50K
Accept: {{contentType}}

### 5.3 Kiểm tra & áp dụng mã voucher FREESHIP2H
GET {{baseUrl}}/vouchers/FREESHIP2H
Accept: {{contentType}}

### 5.4 Kiểm tra mã voucher UBOMEAT
GET {{baseUrl}}/vouchers/UBOMEAT
Accept: {{contentType}}

### 5.5 Tạo mã khuyến mại mới
POST {{baseUrl}}/vouchers
Content-Type: {{contentType}}
Authorization: Bearer {{adminToken}}

{
  "code": "UBOVIP100",
  "badge": "VIP -100K",
  "title": "Giảm 100.000đ cho đơn hàng thực phẩm từ 500.000đ",
  "discountType": "FIXED_AMOUNT",
  "discountValue": 100000,
  "minOrderAmount": 500000,
  "startDate": "2026-09-01T00:00:00",
  "endDate": "2026-12-31T23:59:59",
  "isActive": true
}

### 5.6 Vô hiệu hóa voucher
DELETE {{baseUrl}}/vouchers/4
Authorization: Bearer {{adminToken}}


### ==============================================================================
### 06. ORDERS & CHECKOUT (/v1/orders)
### ==============================================================================

### 6.1 Tạo đơn hàng Online (Kèm giỏ hàng & áp dụng Voucher GIAM50K + FREESHIP2H)
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
  "orderCode": "UBO-TEST-ONLINE-99",
  "channel": "WEB",
  "userId": 3,
  "customerName": "Lê Văn Mua Hàng",
  "customerPhone": "0966666666",
  "shippingAddress": "Phòng 1205 Tòa Nhà Landmark 72, Cầu Giấy, Hà Nội",
  "deliveryMethod": "FAST_2H",
  "note": "Giao hỏa tốc trước 11h trưa để kịp nấu cơm",
  "totalAmount": 224000,
  "shippingFee": 25000,
  "finalAmount": 174000,
  "paymentMethod": "COD",
  "orderStatus": "PENDING",
  "isPrinted": false,
  "items": [
    {
      "productId": 2,
      "productName": "Ba Chỉ Bò Úc Cuộn Nhúng Lẩu Chuẩn Mát",
      "packWeight": "Khay 500g",
      "unit": "Khay",
      "quantity": 1,
      "unitPrice": 89000,
      "imageUrl": "https://images.unsplash.com/photo-1558030006-450675393462?auto=format&fit=crop&w=600&q=80"
    },
    {
      "productId": 13,
      "productName": "Cá Hồi Na Uy Tươi Fillet",
      "packWeight": "Khay 250g",
      "unit": "Khay",
      "quantity": 1,
      "unitPrice": 135000,
      "imageUrl": "https://images.unsplash.com/photo-1519708227418-c8fd9a32b7a2?auto=format&fit=crop&w=600&q=80"
    }
  ],
  "voucherCodes": [
    "GIAM50K",
    "FREESHIP2H"
  ]
}

