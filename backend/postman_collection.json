{
  "info": {
    "name": "UTC Backend API Collection",
    "description": "Collection test toàn bộ API dự án Spring Boot Backend UTC",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "Check Server Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication (Auth)",
      "item": [
        {
          "name": "Login (Đăng nhập)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Register (Đăng ký)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nhanvien01\",\n  \"password\": \"123456\",\n  \"fullName\": \"Nguyễn Văn Nhân Viên\",\n  \"email\": \"nhanvien01@utc.edu.vn\",\n  \"phone\": \"0911223344\",\n  \"roleId\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Change Password (Đổi mật khẩu)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"oldPassword\": \"123456\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "change-password"]
            }
          }
        },
        {
          "name": "Forgot Password (Quên mật khẩu)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/forgot-password?email=admin@utc.edu.vn",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "forgot-password"],
              "query": [
                {
                  "key": "email",
                  "value": "admin@utc.edu.vn"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Danh Mục (Categories)",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/categories",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "categories"]
            }
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rau Củ Quả Tươi\",\n  \"slug\": \"rau-cu-qua-tuoi\",\n  \"description\": \"Các loại rau củ hữu cơ tươi ngon\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/categories",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Sản Phẩm (Products)",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "products"]
            }
          }
        },
        {
          "name": "Search Products by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/products/search?keyword=Vinamilk",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "products", "search"],
              "query": [
                {
                  "key": "keyword",
                  "value": "Vinamilk"
                }
              ]
            }
          }
        },
        {
          "name": "Get Product by SKU",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/products/sku/SP-VNM-1L-001",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "products", "sku", "SP-VNM-1L-001"]
            }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"sku\": \"SP-TH-1L-009\",\n  \"name\": \"Sữa tươi tiệt trùng TH True MILK 1L\",\n  \"unit\": \"Hộp\",\n  \"isWeighing\": false,\n  \"price\": 37000.00,\n  \"costPrice\": 30000.00,\n  \"stockQuantity\": 100.000,\n  \"origin\": \"Việt Nam\",\n  \"imageUrl\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\",\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "products"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Bán Hàng & Đơn Hàng (Orders)",
      "item": [
        {
          "name": "Create Sales Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderCode\": \"ORD-POSTMAN-001\",\n  \"channel\": \"STORE\",\n  \"userId\": 3,\n  \"cashierId\": 2,\n  \"customerName\": \"Nguyễn Văn Khách\",\n  \"customerPhone\": \"0912345678\",\n  \"shippingAddress\": \"Hà Nội\",\n  \"totalAmount\": 70000.00,\n  \"discountAmount\": 0.00,\n  \"finalAmount\": 70000.00,\n  \"paidAmount\": 100000.00,\n  \"changeAmount\": 30000.00,\n  \"paymentMethod\": \"CASH\",\n  \"paymentStatus\": \"PAID\",\n  \"orderStatus\": \"COMPLETED\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"productName\": \"Sữa tươi tiệt trùng Vinamilk 100% Không đường 1L\",\n      \"unit\": \"Hộp\",\n      \"quantity\": 2.000,\n      \"unitPrice\": 35000.00\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "orders"]
            }
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "orders"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Thanh Toán VNPAY",
      "item": [
        {
          "name": "Create VNPAY URL for Order #1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/payment/vnpay/create-payment/1",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "payment", "vnpay", "create-payment", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Nhập Kho (Goods Receipts)",
      "item": [
        {
          "name": "Get All Goods Receipts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/goods-receipts",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "goods-receipts"]
            }
          }
        }
      ]
    },
    {
      "name": "8. Tồn Kho (Inventory History)",
      "item": [
        {
          "name": "Get Stock History of Product #1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/inventory-transactions/product/1",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "inventory-transactions", "product", "1"]
            }
          }
        }
      ]
    }
  ]
}
